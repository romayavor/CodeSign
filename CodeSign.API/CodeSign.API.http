@CodeSign.API_HostAddress = https://localhost:7278
@authToken = YOUR_JWT_TOKEN_HERE

### Register
POST {{CodeSign.API_HostAddress}}/api/Auth/register
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "YourPassword1",
  "fullName": "Your Name",
  "jobTitle": "Your Job Title"
}

###

### Login
POST {{CodeSign.API_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "YourPassword1"
}

