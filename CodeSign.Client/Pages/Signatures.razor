        color: #0f1117;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-new:hover {
            background: #2d9690;
        }

    .alert-error {
        background: rgba(240,100,100,.1);
        border: 1px solid rgba(240,100,100,.3);
        color: #f06464;
        padding: 10px 16px;
        border-radius: 8px;
