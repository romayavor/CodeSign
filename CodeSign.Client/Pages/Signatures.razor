        background: transparent;
        border: 1px solid #2a2e3d;
        color: #9298ad;
        padding: 5px 14px;
        border-radius: 6px;
        font-size: 12px;
        cursor: pointer;
        transition: all .12s;
    }

        .btn-delete:hover {
